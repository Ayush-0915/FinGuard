# Copy this file to .env. Do not commit the real .env file.
# Obtain both values from Supabase: Project Settings -> API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=replace-with-your-server-safe-supabase-key

# The port users open locally. Leave as 8000 unless that port is already occupied.
MULEGUARD_PORT=8000

# Where the API stores temporary/generated PDF reports inside the container.
MULEGUARD_REPORTS_DIR=/var/lib/muleguard/reports
