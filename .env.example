# Copy this file to .env. Do not commit the real .env file.
# Obtain both values from Supabase: Project Settings -> API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=replace-with-your-server-safe-supabase-key

# The port users open locally. Leave as 8000 unless that port is already occupied.
FINGUARD_PORT=8000

# Where the API stores temporary/generated PDF reports inside the container.
FINGUARD_REPORTS_DIR=/var/lib/finguard/reports

# Login credentials (keep private)
AUTH_EMAIL=your-email@example.com
AUTH_PASSWORD=replace-with-a-private-password

# PowerShell startup commands (run from the project root)
FINGUARD_BACKEND_COMMAND=".\.venv\Scripts\python.exe -m uvicorn backend.main:app --host 127.0.0.1 --port 8000"
FINGUARD_FRONTEND_COMMAND=".\.venv\Scripts\python.exe .\frontend\app.py"

BACKEND Health Check: http://127.0.0.1:8000/health